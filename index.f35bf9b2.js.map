"use strict";
document.querySelectorAll("li").forEach(function(li) {
    var textNode = li.firstChild;
    var span = document.createElement("span");
    span.textContent = textNode.textContent;
    textNode.replaceWith(span);
});
document.querySelector(".tree").addEventListener("click", function(e) {
    var li = e.target.closest("li");
    var childUl = li.querySelector("ul");
    if (childUl.hasAttribute("hidden")) childUl.removeAttribute("hidden");
    else childUl.setAttribute("hidden", true);
});

